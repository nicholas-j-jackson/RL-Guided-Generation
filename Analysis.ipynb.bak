   "source": [
    "import time\n",
    "import torch, torch.nn as nn, torch.nn.functional as F\n",
    "from torch.utils.data import DataLoader, TensorDataset\n",
    "import pandas as pd\n",
    "import os \n",
    "from pathlib import Path\n",
    "import numpy as np \n",
    "import argparse \n",
    "from RL.hyperparams import HyperParams_ACS\n",
    "from RL.evaluation import evaluate_model\n",
    "from RL.models import build_models\n",
    "from RL.main import set_seed\n",
    "import random\n",
    "from tqdm import tqdm\n",
    "import matplotlib.pyplot as plt"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "a5162564",
   "metadata": {},
   "outputs": [],
   "source": [
    "import tableone"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "b712b23b",
   "metadata": {},
   "outputs": [],
   "source": [
    "def load_data(dataset):\n",
    "    return pd.concat([pd.read_csv(f'preprocessing/{dataset}/data/unnormalized_{split}.csv', index_col=0) for split in ['train', 'val', 'test']])\n",
    "\n",
    "def load_synth_data(dataset):\n",
    "    return pd.read_csv(f'{dataset}/results/50/synthetic_rescaled.csv', index_col=0)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "a0222163",
   "metadata": {},
   "outputs": [],
   "source": [
    "acs = load_data('ACS')\n",
    "mimic = load_data('MIMIC')\n",
    "\n",
    "acs_syn = load_synth_data('ACS')\n",
    "mimic_syn = load_synth_data(\"MIMIC\")"
   ]
  },
