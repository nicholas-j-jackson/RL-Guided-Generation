     ]
    }
   ],
   "source": [
    "df_train = pd.read_csv('preprocessing/MIMIC/data/unnormalized_train.csv', index_col=0)\n",
    "df_test = pd.read_csv('preprocessing/MIMIC/data/unnormalized_test.csv', index_col=0)\n",
    "df_syn_base = pd.read_csv('MIMIC/results/50/synthetic_rescaled.csv', index_col=0)\n",
    "df_syn_pen = pd.read_csv('MIMIC/results/penalized/50/synthetic_rescaled.csv', index_col=0)\n",
    "\n",
    "res = fairness_analysis(df_train, df_syn_base, df_syn_pen, df_test, \"MIMIC\")"
   ]
