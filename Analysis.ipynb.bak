       "   {'syn_model_auc': 0.851, 'coef_corr': 1.0, 's2r_auc': 0.9718, 'dwd': 0.0},\n",
       "   {'syn_model_auc': 0.851, 'coef_corr': 1.0, 's2r_auc': 0.9723, 'dwd': 0.0}],\n",
       "  'penalized': [{'syn_model_auc': 0.8746,\n",
       "    'coef_corr': 1.0,\n",
