     "text": [
      "\n",
      "======================================================================\n",
      "Fairness Analysis — AUC on held-out real test set (MIMIC)\n",
      "======================================================================\n",
      "Subgroup                         n_test       Real      RLSyn    RLSyn+Reg\n",
      "----------------------------------------------------------------------\n",
      "Overall                            2760     0.8421     0.7544       0.8182\n",
