   "cell_type": "code",
   "execution_count": 15,
   "id": "28900238",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 900x550 with 1 Axes>"
      ]
     },
